# cp lms.env.example lms.env  — keyin qiymatlarni o'zgartiring
APP_NAME=O'quv markazi
COMPANY_NAME=
ADMIN_NAME=Administrator
ADMIN_PHONE=998900000000
ADMIN_PASSWORD=change-me-please
# 1 bo'lsa, birinchi ishga tushishda demo xodimlar, treninglar, videolar va natijalar yaratiladi
DEMO_SEED=1
DEMO_PASSWORD=demo123
# Telegram bot (@BotFather'dan). Bo'sh bo'lsa — bot o'chiq
TELEGRAM_BOT_TOKEN=
# Saytning ochiq manzili (Telegram xabarlaridagi tugmalar uchun, https bo'lishi shart)
PUBLIC_URL=https://lms.example.uz
# SESSION_SECRET=... (bo'lmasa data/.secret avtomatik yaratiladi)
